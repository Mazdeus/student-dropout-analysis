    "# buat dan latih model decision tree\n",
    "tree_model = DecisionTreeClassifier(\n",
    "    random_state=123,\n",
    "    criterion='gini',\n",
    "    max_depth=14,\n",
    "    max_features='sqrt'\n",
    ")\n",
    "\n",
    "tree_model.fit(X_train_scaled, y_train_encoded)\n",
    "joblib.dump(tree_model, \"model/tree_model.joblib\")"
   ]
