   "source": [
    "### Menangani Imbalanced Data (Binary Classification)\n",
    "\n",
    "Dataset untuk pemodelan hanya menggunakan dua kelas akhir:\n",
    "- **Dropout**\n",
    "- **Graduate**\n",
    "\n",
    "Status **Enrolled** tidak digunakan dalam training karena masih merepresentasikan siswa yang belum memiliki label akhir.\n",
    "Kita tetap melakukan balancing pada data training agar model tidak bias ke kelas mayoritas.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BALANCING - MENANGANI IMBALANCED DATA\n",
      "\n",
      "Jumlah sampel SEBELUM balancing:\n",
      "Status\n",
      "Graduate    1767\n",
      "Dropout     1137\n",
      "Name: count, dtype: int64\n",
      "\n",
      "Ukuran target tiap kelas: 1137 sampel\n",
      "Graduate setelah balancing: 1137 sampel\n",
      "Dropout setelah balancing: 1137 sampel\n",
      "\n",
      "Total sampel SETELAH balancing: 2274\n",
      "\n",
      "Jumlah sampel SETELAH balancing:\n",
      "Status\n",
      "Dropout     1137\n",
      "Graduate    1137\n",
      "Name: count, dtype: int64\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# BALANCING - Menangani Imbalanced Data pada Training Set\n",
    "print(\"BALANCING - MENANGANI IMBALANCED DATA\")\n",
    "\n",
    "# Gabungkan X_train dan y_train untuk proses balancing\n",
    "train_df = X_train.copy()\n",
    "train_df['Status'] = y_train.values\n",
    "\n",
    "# Cek jumlah sampel setiap kelas\n",
    "print(\"\\nJumlah sampel SEBELUM balancing:\")\n",
    "print(train_df['Status'].value_counts())\n",
    "\n",
    "# Pisahkan berdasarkan kelas\n",
    "df_graduate = train_df[train_df['Status'] == 'Graduate']\n",
    "df_dropout = train_df[train_df['Status'] == 'Dropout']\n",
    "\n",
    "# Balancing dilakukan dengan menyesuaikan kelas mayoritas ke ukuran kelas minoritas\n",
    "n_minority = min(len(df_graduate), len(df_dropout))\n",
    "print(f\"\\nUkuran target tiap kelas: {n_minority} sampel\")\n",
    "\n",
    "df_graduate_balanced = resample(df_graduate, n_samples=n_minority, random_state=42)\n",
    "df_dropout_balanced = resample(df_dropout, n_samples=n_minority, random_state=42)\n",
    "\n",
    "print(f\"Graduate setelah balancing: {len(df_graduate_balanced)} sampel\")\n",
    "print(f\"Dropout setelah balancing: {len(df_dropout_balanced)} sampel\")\n",
    "\n",
    "# Gabungkan semua data yang sudah diseimbangkan\n",
    "balanced_train_df = pd.concat([df_graduate_balanced, df_dropout_balanced])\n",
    "balanced_train_df = shuffle(balanced_train_df, random_state=42)\n",
    "balanced_train_df.reset_index(drop=True, inplace=True)\n",
    "\n",
    "# Pisahkan kembali X_train dan y_train\n",
    "X_train = balanced_train_df.drop('Status', axis=1)\n",
    "y_train = balanced_train_df['Status']\n",
    "\n",
    "print(f\"\\nTotal sampel SETELAH balancing: {len(X_train)}\")\n",
    "print(\"\\nJumlah sampel SETELAH balancing:\")\n",
    "print(y_train.value_counts())\n",
    "\n",
    "# Visualisasi SETELAH balancing\n",
    "plt.figure(figsize=(8, 4))\n",
    "sns.countplot(x=y_train, palette='viridis', order=['Dropout', 'Graduate'])\n",
    "plt.title('Distribusi Target - Training Set (SETELAH Balancing)', fontsize=12, fontweight='bold')\n",
    "plt.xlabel('Status')\n",
    "plt.ylabel('Jumlah')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
